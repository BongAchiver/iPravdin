{
  "manifest_version": 3,
  "name": "iPravdin",
  "description": "Правдин в интернете: фотографии, задачки по матану, настроение, прятки и коллекция редких Правдиных. Без аналитики.",
  "version": "2.6.0",
  "icons": {
    "16": "ipravdin/icons/icon-16.png",
    "32": "ipravdin/icons/icon-32.png",
    "48": "ipravdin/icons/icon-48.png",
    "64": "ipravdin/icons/icon-64.png",
    "96": "ipravdin/icons/icon-96.png",
    "128": "ipravdin/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "ipravdin/settings.js",
      "ipravdin/bg.js",
      "ipravdin/game-bank.js",
      "ipravdin/game-lines.js",
      "ipravdin/game.js",
      "ipravdin/game-bg.js"
    ]
  },
  "action": {
    "default_title": "iPravdin",
    "default_popup": "ipravdin/options/popup.html",
    "default_icon": {
      "16": "ipravdin/icons/icon-16.png",
      "32": "ipravdin/icons/icon-32.png",
      "48": "ipravdin/icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "ipravdin/settings.js",
        "ipravdin/game-bank.js",
        "ipravdin/game-lines.js",
        "ipravdin/game.js",
        "ipravdin/ipravdin.js",
        "ipravdin/game-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ipravdin/photos/*.jpg",
        "ipravdin/reactions/*.jpg",
        "ipravdin/collectibles/*.jpg",
        "ipravdin/game.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "options_ui": {
    "page": "ipravdin/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "inikolayev-firefox@vint352.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://github.com/BongAchiver/iPravdin/releases/latest/download/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
