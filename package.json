{
  "name": "ipravdin-firefox",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "addons-linter app --self-hosted --warnings-as-errors",
    "build": "node scripts/build.cjs",
    "test:firefox": "node tests/firefox.cjs",
    "test:firefox:schedule": "node tests/firefox-schedule.cjs",
    "version:set": "node scripts/version.cjs",
    "updates:configure": "node scripts/configure-updates.cjs",
    "sign": "web-ext sign --source-dir app --artifacts-dir dist/signed --channel unlisted --no-input",
    "updates:prepare": "node scripts/prepare-updates.cjs"
  },
  "devDependencies": {
    "addons-linter": "^10.13.0",
    "archiver": "^8.0.0",
    "jsdom": "^29.1.1",
    "selenium-webdriver": "^4.50.0",
    "web-ext": "^10.7.0"
  }
}
